# Flashword Environment Configuration
# Copy this file to .env.local for local development or set these variables in Vercel.

# Secret key used for signing session auth cookies (HMAC-SHA256)
SESSION_SECRET=flashword-super-secure-production-secret-replace-in-prod-min-32-chars

# Admin management token (header: x-admin-token)
ADMIN_TOKEN=admin-flash-secret

# Database path (optional - defaults to ./data/flashword.db locally or /tmp/flashword.db on Vercel)
# DATABASE_PATH=./data/flashword.db
